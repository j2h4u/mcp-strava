# Copy to .env and fill the local values. Keep .env out of git.

# Strava OAuth application credentials from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Tokens returned by the authorization-code exchange.
# STRAVA_ACCESS_TOKEN and STRAVA_REFRESH_TOKEN are refreshed in-place.
STRAVA_ACCESS_TOKEN=
STRAVA_REFRESH_TOKEN=
STRAVA_EXPIRES_AT=

# Athlete physiology required for HR zones, TRIMP, and HRR metrics.
MCP_STRAVA_HR_REST=

# Optional local overrides. Defaults are usually enough for development.
# MCP_STRAVA_HR_ZONE_MODEL=karvonen_hrr
# MCP_STRAVA_RUNTIME_PROFILE=local
# MCP_STRAVA_DB_PATH=data/strava.duckdb
# MCP_STRAVA_HTTP_HOST=127.0.0.1
# MCP_STRAVA_HTTP_PORT=8000
# MCP_STRAVA_PROMPT_LANGUAGE=en
